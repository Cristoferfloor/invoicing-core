CORE_PORT=3006

# Base "invoicing" de Infrastructure/ (usuario core)
CORE_MONGO_URL=mongodb://core:CLAVE@mongo:27017/invoicing?authSource=admin&replicaSet=rs0

# Token de los endpoints de este servicio (header X-Token-Admin)
CORE_ADMIN_TOKEN=

# Servicios que usa (por la red pac-invoicing-v2)
CONFIG_URL=http://config:3003
CONFIG_ADMIN_TOKEN=
XML_GENERATOR_URL=http://xml-generator:3002
SIGNER_URL=http://signer:3001

# Comprobantes que procesa a la vez
CONCURRENCY=4
# Revision de respaldo de REGISTRADO pendientes (ms)
SWEEP_MS=30000
# Reintentos ante servicios caidos antes de marcar ERROR
MAX_RETRIES=5
